# Скопируйте в .env.local (локально) и в Environment Variables на Vercel.
# Без Supabase сайт работает на данных из src/lib/tours/seed-tours.json.

# Адрес сайта без слеша в конце — нужен для ссылок в боте, sitemap и Open Graph
NEXT_PUBLIC_SITE_URL=https://jingletour.uz

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только на сервере! Никогда не добавляйте префикс NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Telegram-бот от @BotFather
TELEGRAM_BOT_TOKEN=
# Любая длинная случайная строка (A-Z, a-z, 0-9, _ и -), её же передаём в setWebhook
TELEGRAM_WEBHOOK_SECRET=
# id канала вида -100…; если пусто, канал узнаём по username jingle_tour
TELEGRAM_CHANNEL_ID=
# chat_id администраторов через запятую (мама пишет боту /start — бот отвечает её chat_id)
ADMIN_CHAT_IDS=

# Соль для хеша IP в заявках; если пусто, используется service-role ключ
REQUEST_IP_SALT=
